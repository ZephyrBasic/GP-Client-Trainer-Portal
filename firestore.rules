rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The shared trainer signup code, and nothing else yet.
    //
    // Denied on both verbs to every client, which is the entire point: rules'
    // get() reads documents the requester cannot (see knowsTrainerCode below),
    // and the Firebase console and Admin SDK bypass rules altogether. So the
    // code is checkable without being readable, and rotating it is a one-field
    // edit in the console - no rebuild, no redeploy, no new app version.
    //
    // Document: config/trainerSignup, field `code` (string). If it does not
    // exist, no new trainer can register. That is the intended failure mode:
    // a missing gate has to fail closed.
    match /config/{docId} {
      allow read, write: if false;
    }

    // A Trainer's invite code, keyed by the code itself, holding only their uid.
    //
    // This exists so `users` does not have to be readable by everyone. Client
    // registration used to find the Trainer by querying `users` on inviteCode,
    // which meant any signed-in account could list every email and every code.
    // Now a new Client fetches exactly one document by the code they typed.
    //
    // get but never list: knowing a code is what entitles you to its Trainer,
    // so the collection must not be enumerable. A get reveals only a uid, and a
    // uid opens nothing - `users` below is closed to strangers.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      // Only a Trainer, only for themselves, and only the code their own
      // profile already carries - so nobody can claim a code they were not
      // issued. Create-only: a write to an existing code is an update, so a
      // collision is denied rather than silently re-pointing someone else's
      // Clients. The profile's inviteCode is pinned below for the same reason.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['trainerId'])
        && request.resource.data.trainerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == code;

      allow update: if false;

      // Account deletion and a rolled-back registration both tidy their own.
      allow delete: if isOwner(resource.data.trainerId);
    }

    match /users/{uid} {
      // Yourself, your Clients (if you are a Trainer), and your Trainer (if you
      // are a Client). Nobody else: a profile carries an email address, and a
      // Trainer's carries their invite code.
      //
      // The second clause is what lets useClients list a roster: the query
      // filters on trainerId == me, which rules can prove from the filter
      // alone. The third costs one get() of the reader's own profile.
      //
      // Note what this rule does *not* cover: in rules v2 a match on a document
      // path says nothing about the paths beneath it, so the private/
      // subcollection below is not readable through this clause. The signup
      // gate depends on that.
      allow read: if isOwner(uid)
        || (isSignedIn() && resource.data.trainerId == request.auth.uid)
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId == uid);

      // Did this applicant write the current shared trainer signup code into
      // their own private scratch document?
      //
      // Two get()s, and neither value is ever legible to a client: the code
      // lives in config/ (denied above) and the answer in users/{uid}/private/
      // (denied below). That asymmetry - rules can read what the client cannot -
      // is the whole mechanism. The obvious alternative, carrying the code as a
      // field on the user document being created, would put it in front of
      // whoever can read that profile - which includes every future Client of
      // the new Trainer.
      //
      // exists() before get() on both, because get() on a missing document
      // errors rather than returning null, and an erroring rule is a denial with
      // a confusing message rather than a clean one.
      function knowsTrainerCode(applicant) {
        return exists(/databases/$(database)/documents/config/trainerSignup)
          && exists(/databases/$(database)/documents/users/$(applicant)/private/signup)
          && get(/databases/$(database)/documents/users/$(applicant)/private/signup).data.trainerCode
             == get(/databases/$(database)/documents/config/trainerSignup).data.code;
      }

      // Registering as a client is gated by a trainer's own invite code, which
      // the app checks for itself against inviteCodes/. Registering as a
      // trainer is gated here instead, for the reason above. The || short
      // circuits, so a client registration still costs zero extra get()s.
      allow create: if isOwner(uid)
        && request.resource.data.role in ['client', 'trainer']
        && (request.resource.data.role != 'trainer' || knowsTrainerCode(uid));

      // Role and trainerId are set once at registration and are not
      // user-editable afterwards, to prevent self-promotion to trainer or
      // re-linking to a different trainer. inviteCode likewise: inviteCodes/
      // trusts it when a code is claimed, so a Trainer who could rewrite it
      // could claim any unissued code.
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.get('inviteCode', null) == resource.data.get('inviteCode', null);

      // Deleting your own account is required in-app by Apple guideline
      // 5.1.1(v) and by Google Play, so this is no longer `if false`. Your own
      // document, by you, and nothing else.
      //
      // What it deliberately does NOT do is stop a Trainer deleting themselves
      // out from under their Clients, whose profiles point at them by trainerId
      // and whose update rule just above refuses to let that field change. Rules
      // cannot run a query, so "does this Trainer still have Clients?" is
      // unanswerable here - the same limit that leaves the single-active-Session
      // rule to the UI (ADR 0003). utils/deleteAccount.ts holds that guard, and
      // it can only ever be a product rule: Firebase Auth always lets an account
      // delete itself, so no rule here could make it a security boundary.
      allow delete: if isOwner(uid);

      // Write-only scratch space for the signup gate - unreadable to everyone,
      // including its own owner.
      //
      // The applicant writes what they typed to private/signup, the create rule
      // above compares it against config/trainerSignup, and AuthContext.signUp
      // deletes it the moment registration succeeds so no copy of a shared
      // secret outlives its use. Write, not just create, so a second attempt
      // after a wrong code can overwrite the first; read stays false forever.
      //
      // Written before the user document rather than batched with it, because
      // rules cannot see a sibling write in the same batch - the same ordering
      // constraint that makes a Template precede its first Version.
      match /private/{docId} {
        allow read: if false;
        allow write: if isOwner(uid);
      }
    }

    match /sessions/{sessionId} {
      // A Session is a record of one workout a client actually performed. This
      // collection was called `workouts` until the rename; the rules below are
      // unchanged in effect, only re-pathed. Deploy them only once
      // scripts/migrate-workouts-to-sessions.js has copied the data across -
      // until then this path matches nothing and every client's history is
      // denied by the catch-all at the bottom of the file.
      function isLinkedTrainer(clientId) {
        return isSignedIn()
          && get(/databases/$(database)/documents/users/$(clientId)).data.trainerId == request.auth.uid;
      }

      // Owning client has full control; their linked trainer gets read-only
      // access (sessions are logged by clients, viewed by trainers).
      //
      // A session in flight is the same document in the same collection: it is
      // created when the client taps start, updated once when they finish, and
      // deleted if they discard it. These three clauses already cover all of
      // that, so live sessions needed no new rule - which is the point of
      // keeping status a field rather than a separate collection.
      //
      // Two things are deliberately NOT enforced here. That a client has only
      // one session open is a product rule held in the UI (ADR 0003): rules
      // cannot run a query, and the alternatives - a pointer on the user
      // document kept consistent by a batched write, or a fixed path the
      // session migrates out of - add a failure mode to every session write to
      // prevent an outcome that grants no access to anything. And a completed
      // session is not frozen against later update: the owning client may edit
      // their own record, which is what makes a duration or a date correctable.
      allow read: if isOwner(resource.data.clientId) || isLinkedTrainer(resource.data.clientId);
      allow create: if isOwner(request.resource.data.clientId);
      allow update, delete: if isOwner(resource.data.clientId);
    }

    match /workoutTemplates/{templateId} {
      // A Workout Template is one object whoever authored it - a trainer's
      // prescription and a client's own saved routine are the same document -
      // so every rule here keys off authorId and none of them looks up a role.

      // The second reader is an assigned client, and this is the whole reason an
      // assignment's id is derived from the pair rather than minted: rules
      // cannot run a query, so "is this client assigned?" has to be a path we
      // can build and test. Same trick /chats uses to avoid a participants
      // array. Kept in step with utils/assignmentId.ts - if the separator ever
      // changes, it changes in both places or clients silently lose access.
      //
      // Existence, deliberately, not `active`. Unassigning soft-removes (ADR
      // 0004): the document stays, so a client who has been unassigned can still
      // read the template and versions their past sessions cite. Only their
      // workout list honours the flag.
      function isAssignedClient() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/assignments/$(templateId + '_' + request.auth.uid));
      }

      allow read: if isOwner(resource.data.authorId) || isAssignedClient();

      allow create: if isOwner(request.resource.data.authorId);

      // Only the author edits, and authorship is fixed at creation: reassigning
      // it would hand a template - and every client assigned to it - to someone
      // who never wrote it.
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.authorId == resource.data.authorId;

      // No delete at all. Sessions cite the version they ran (ADR 0002), and
      // deleting the parent would orphan those versions and make a client's own
      // history unreadable. Retiring a template is unassigning it, not deleting.
      allow delete: if false;

      match /versions/{versionId} {
        function templateAuthor() {
          return get(/databases/$(database)/documents/workoutTemplates/$(templateId)).data.authorId;
        }

        // Versions follow the parent: whoever may read the template may read its
        // contents. An assigned client needs this to perform the workout, and
        // needs it to keep working after being unassigned, since a past session
        // cites the exact version it ran.
        allow read: if (isSignedIn() && templateAuthor() == request.auth.uid) || isAssignedClient();

        // Create-only, and only by the template's author. This get() is why
        // hooks/useWorkoutTemplates writes the template before its first
        // version rather than batching the pair: rules cannot see a sibling
        // write, so a batch would find no parent here and be denied. Publishing
        // a later version inverts that order - the parent already exists, so the
        // version is written first and the pointer moved after it.
        allow create: if isSignedIn() && templateAuthor() == request.auth.uid;

        // A version is immutable. Progressing a workout publishes a new one
        // (ADR 0002); editing or deleting an old one would silently rewrite
        // what a past session appears to have been asked to do.
        //
        // This is the whole guarantee, and it needs no help: a write to a
        // document that already exists is an update, never a create, so the
        // create rule above cannot be used to overwrite a version by reusing
        // its id.
        allow update, delete: if false;
      }
    }

    match /assignments/{assignmentId} {
      // An assignment joins one client to one workout template and carries that
      // client's target frequency (ADR 0004). Its id is always the derived pair
      // "templateId_clientId", which is what makes the existence check on
      // workoutTemplates above possible - see utils/assignmentId.ts.
      //
      // Top-level rather than a subcollection of the template, so a client can
      // ask "what am I prescribed?" with one equality filter instead of a
      // collection-group query.
      function templateAuthor(templateId) {
        return get(/databases/$(database)/documents/workoutTemplates/$(templateId)).data.authorId;
      }
      function trainerOf(clientId) {
        return get(/databases/$(database)/documents/users/$(clientId)).data.trainerId;
      }

      // Per-client target loads (ADR 0004) ride on this same document as one
      // optional map keyed by exercise id. Absent means "no overrides", which is
      // why adding them needed no migration.
      //
      // Constrained to being a map and no further, deliberately. Rules cannot
      // walk a structure of arbitrary keys, and the value of trying would be
      // small: the write rules below already say only the owning trainer may
      // touch this document at all, so nobody can set a client's loads but the
      // person whose job that is. utils/prescription reads anything it does not
      // recognise as "no override", so a malformed entry falls back to the
      // template's own targets rather than to bad ones.
      function overridesWellFormed(data) {
        return !data.keys().hasAny(['targetOverrides']) || data.targetOverrides is map;
      }

      // The named client and the owning trainer, and nobody else. Both clauses
      // read stored fields rather than deriving anything from the id, because
      // the id is only trustworthy inasmuch as create verified it - which it
      // does, below.
      allow read: if isOwner(resource.data.clientId) || isOwner(resource.data.trainerId);

      // Four things have to hold, and dropping any one of them breaks a
      // different guarantee:
      //
      //   - the writer is the trainer named on the document, so a client can
      //     never assign anything to themselves;
      //   - the id is exactly the pair it claims to join. Without this a trainer
      //     could write a document whose id names someone else's template and
      //     hand their own client read access to it, since the template's read
      //     rule only ever tests that the path exists;
      //   - the trainer authored the template, so nobody assigns work they did
      //     not write;
      //   - the client is theirs. trainerId is only ever set on client profiles
      //     (see AuthContext), so this doubles as the role check.
      allow create: if isOwner(request.resource.data.trainerId)
        && assignmentId == request.resource.data.templateId + '_' + request.resource.data.clientId
        && templateAuthor(request.resource.data.templateId) == request.auth.uid
        && trainerOf(request.resource.data.clientId) == request.auth.uid
        && request.resource.data.timesPerWeek is number
        && request.resource.data.active is bool
        && overridesWellFormed(request.resource.data);

      // Only the owning trainer, and only the mutable parts: which client and
      // which template are fixed at creation. Changing either would let a
      // verified id go stale and describe a pair the document no longer joins,
      // which is the one thing the create rule exists to prevent. trainerId is
      // pinned for the same reason it is on a user profile - it is the field the
      // read and write rules key off.
      allow update: if isOwner(resource.data.trainerId)
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.timesPerWeek is number
        && request.resource.data.active is bool
        && overridesWellFormed(request.resource.data);

      // Never deleted. The surviving document is what keeps the existence check
      // on workoutTemplates true, and that is what keeps a client's past
      // sessions readable after they are unassigned (ADR 0004). Unassigning
      // clears `active`; it does not remove anything.
      allow delete: if false;
    }

    match /chats/{chatId} {
      // chatId is always the deterministic pair "clientId_trainerId" - a
      // client only ever has one trainer, so both sides can derive it
      // locally without a lookup, and rules can verify it without a
      // separate participants array.
      function isLinkedPair(clientId, trainerId) {
        return get(/databases/$(database)/documents/users/$(clientId)).data.trainerId == trainerId;
      }
      function isParticipant() {
        return isOwner(resource.data.clientId) || isOwner(resource.data.trainerId);
      }

      allow read: if isParticipant();

      allow create: if (isOwner(request.resource.data.clientId) || isOwner(request.resource.data.trainerId))
        && chatId == request.resource.data.clientId + '_' + request.resource.data.trainerId
        && isLinkedPair(request.resource.data.clientId, request.resource.data.trainerId);

      // clientId/trainerId are fixed at creation; only lastMessage-style
      // metadata may change afterwards.
      allow update: if isParticipant()
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.trainerId == resource.data.trainerId;

      allow delete: if false;

      match /messages/{messageId} {
        function isChatParticipant() {
          return isSignedIn()
            && (get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid
                || get(/databases/$(database)/documents/chats/$(chatId)).data.trainerId == request.auth.uid);
        }

        // Messages are immutable once sent - no update/delete for v1.
        allow read: if isChatParticipant();
        allow create: if isChatParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /customExercises/{exerciseId} {
      function myProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      // The library a client sees is their own trainer's, so exercise names
      // don't leak between unrelated trainers.
      allow read: if isOwner(resource.data.createdBy)
        || (isSignedIn() && myProfile().trainerId == resource.data.createdBy);

      // Clients can never extend the library - that's the whole point of
      // select-only logging, so the rule enforces it server-side rather than
      // relying on the picker hiding the button.
      // `fields` decides which set inputs a client is shown and what gets stored,
      // so it is constrained here rather than trusted from the picker.
      allow create: if isSignedIn()
        && myProfile().role == 'trainer'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.fields is list
        && request.resource.data.fields.size() > 0
        && request.resource.data.fields.hasOnly(['weightKg', 'reps', 'distanceMeters', 'durationSeconds']);

      allow update: if isOwner(resource.data.createdBy)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOwner(resource.data.createdBy);
    }

    match /progressMedia/{mediaId} {
      function isLinkedTrainer(clientId) {
        return isSignedIn()
          && get(/databases/$(database)/documents/users/$(clientId)).data.trainerId == request.auth.uid;
      }

      // Owning client has full control (photo/video is theirs to manage);
      // their linked trainer gets read-only access plus the ability to
      // comment (handled in the comments subcollection below).
      allow read: if isOwner(resource.data.clientId) || isLinkedTrainer(resource.data.clientId);
      allow create: if isOwner(request.resource.data.clientId)
        && request.resource.data.type in ['photo', 'video'];
      allow update: if false;
      allow delete: if isOwner(resource.data.clientId);

      match /comments/{commentId} {
        function parentClientId() {
          return get(/databases/$(database)/documents/progressMedia/$(mediaId)).data.clientId;
        }
        function isCommentParticipant() {
          return isOwner(parentClientId()) || isLinkedTrainer(parentClientId());
        }

        // Comments are immutable once posted - no update/delete for v1.
        allow read: if isCommentParticipant();
        allow create: if isCommentParticipant() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Default deny for everything else until each phase defines its own
    // rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
