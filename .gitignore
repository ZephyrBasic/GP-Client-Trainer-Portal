# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# service account keys for the Admin SDK migration scripts - never committed
secrets/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Claude Code settings
.claude/settings.local.json

# working notes and plans - scratch, not part of the repo's documentation
.claude/docs/

# tickets and local skills: the assistant's working files, not the app's. They
# turn over far faster than the code, and without these three lines a plain
# `git add -A` sweeps all of them into a commit.
.claude/tickets/
.claude/skills/
Next Steps List.txt

# harvester output, not a constant: find-exercise-videos.py writes it and
# promote-videos.js reads it. 1.4 MB of intermediate, regenerated on demand.
constants/videoCandidates.json
