# Copy this file to .env and fill in your Firebase project's web config
# (Firebase Console > Project Settings > General > Your apps > SDK setup and configuration)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Crash and error reports (utils/crashReporting.ts). Leave it blank
# and the app is completely unaffected: no Sentry init, no handlers, no console
# noise - reporting is simply inert.
#
# EXPO_PUBLIC_ on purpose, unlike the key below, and for two separate reasons.
# A Sentry DSN is public by nature: it ships inside every web bundle and every
# app binary, and the one permission it grants is to *submit* an event - it
# reads nothing back and spends nothing. And EXPO_PUBLIC_ is the only prefix
# Expo inlines into the client bundle at all, so a DSN spelled any other way
# would be undefined at runtime.
# Sentry > Project Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Optional. App Check reCAPTCHA v3 site key (firebase/config.ts). Leave it blank
# and App Check is skipped entirely. Web only - see the comment in config.ts for
# why native clients cannot attest under the JS SDK, and why enforcement must
# stay in "monitor" in the Firebase console while that is true.
# A site key is public by design (reCAPTCHA puts it in the page); the secret key
# never belongs here. Firebase Console > App Check > Apps > reCAPTCHA v3
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Optional, and deliberately not EXPO_PUBLIC_ - this is read only by
# scripts/verify-videos.js under bare node, never bundled into the app.
# YouTube Data API v3 key, for checking how-to demos still exist and are
# the right length: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# App-store reviewer accounts, seeded by `node scripts/seed-test-data.js --review`.
# Optional: leave unset and the seed mints one and prints it once. Not
# EXPO_PUBLIC_ - read only by that script under bare node. Never commit real values.
REVIEW_PASSWORD_APPLE=
REVIEW_PASSWORD_GOOGLE=
