# Copy this file to .env and fill in your Firebase project's web config
# (Firebase Console > Project Settings > General > Your apps > SDK setup and configuration)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional, and deliberately not EXPO_PUBLIC_ - this is read only by
# scripts/verify-videos.js under bare node, never bundled into the app.
# YouTube Data API v3 key, for checking how-to demos still exist and are
# the right length: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
